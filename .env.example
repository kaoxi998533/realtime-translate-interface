OPENAI_API_KEY=sk-your-api-key-here
REALTIME_MODEL=gpt-realtime
PORT=3000
HOST=127.0.0.1

# Faster auto-listen response after the speaker stops.
REALTIME_VAD_SILENCE_DURATION_MS=450
REALTIME_VAD_THRESHOLD=0.78
REALTIME_VAD_PREFIX_PADDING_MS=250
REALTIME_OUTPUT_SPEED=1
REALTIME_VOICE=marin
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
REALTIME_SESSION_TTL_SECONDS=600
